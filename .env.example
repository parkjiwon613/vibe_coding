# Preferred server-only names. Never add these values to client-side code.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Backward compatibility:
# Existing .env.local or Vercel variables named VITE_SUPABASE_URL and
# VITE_SUPABASE_PUBLISHABLE_KEY are also read server-side.
# They are NOT exposed to the browser because vite.config.ts sets envPrefix: [].
